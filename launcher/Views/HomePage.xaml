<UserControl x:Class="v232.Launcher.WPF.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <!-- HERO -->
        <Grid Margin="0,8,36,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="// SYSTEM ONLINE" Style="{StaticResource HudLight}" Margin="0,0,0,14"/>
                <TextBlock x:Name="BrandNameText" Text="KonoMS" FontFamily="{StaticResource DisplayFont}" FontSize="64" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="0" Color="{DynamicResource PrimaryAccentColor}" Opacity="0.55"/>
                    </TextBlock.Effect>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <StackPanel Width="70">
                        <Border Height="3" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{DynamicResource PrimaryAccentColor}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource SecondaryAccentColor}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="SloganText" Text="GMS-V-265-Private Server" Style="{StaticResource HudLight}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TaglineText" Text="Every hero begins as a dot on the grid."
                           Style="{StaticResource BodyText}" Margin="0,18,0,0" FontSize="15"/>
            </StackPanel>

            <!-- LAUNCH + STATUS -->
            <StackPanel Grid.Row="1" Margin="0,34,0,0">
                <Button x:Name="PlayButton" Style="{StaticResource GlowButton}" HorizontalAlignment="Left"
                        Width="300" Padding="0,20" FontSize="17">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M8,5 L19,12 L8,19 Z" Fill="{StaticResource BackgroundDeepBrush}" Width="16" Height="16"
                              Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <TextBlock Text="INITIALIZE LAUNCH" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="AuthHint" Text="Not signed in — sign in to launch the game."
                           Style="{StaticResource MutedText}" Margin="0,14,0,0" FontSize="11"/>

                <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                    <Border Style="{StaticResource GlassCard}" Padding="18,14" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="SERVER" Style="{StaticResource HudLight}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="StatusText" Text="CONNECTING" Style="{StaticResource SubHeaderText}" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Padding="18,14" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="CLIENT" Style="{StaticResource HudLight}"/>
                            <TextBlock x:Name="ClientStatusText" Text="SCANNING" Style="{StaticResource SubHeaderText}" FontSize="13" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="VERSION" Style="{StaticResource HudLight}"/>
                            <TextBlock x:Name="VersionText" Text="v265" Style="{StaticResource SubHeaderText}" FontSize="13" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- OPERATIVES + WALLET -->
            <Grid Grid.Row="2" Margin="0,26,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="286"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="22,18" Margin="0,0,14,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="TOP OPERATIVES" Style="{StaticResource HudLight}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OperativesAccount" Text="" Style="{StaticResource AccentText}" FontSize="11"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="OperativesEmpty" Grid.Row="1" Text="SIGN IN TO LOAD YOUR OPERATIVES"
                                   Style="{StaticResource MutedText}" FontSize="11" Margin="0,16,0,6"/>

                        <Grid Grid.Row="1" x:Name="OperativesList" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="OperativeRow1" Grid.Row="0" Style="{StaticResource GlassCard}" Padding="12,10" Margin="0,0,0,8" Background="{StaticResource BackgroundElevatedBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Rank1" Grid.Column="0" Text="01" Style="{StaticResource AccentText}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CharName1" Grid.Column="1" Text="—" Style="{StaticResource SubHeaderText}" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CharJob1" Grid.Column="2" Text="" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <TextBlock x:Name="CharLevel1" Grid.Column="3" Text="" Style="{StaticResource AccentText}" FontSize="14" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </Grid>
                            </Border>

                            <Border x:Name="OperativeRow2" Grid.Row="1" Style="{StaticResource GlassCard}" Padding="12,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Rank2" Grid.Column="0" Text="02" Style="{StaticResource MutedText}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CharName2" Grid.Column="1" Text="—" Style="{StaticResource SubHeaderText}" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CharJob2" Grid.Column="2" Text="" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <TextBlock x:Name="CharLevel2" Grid.Column="3" Text="" Style="{StaticResource MutedText}" FontSize="14" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </Grid>
                            </Border>

                            <Border x:Name="OperativeRow3" Grid.Row="2" Style="{StaticResource GlassCard}" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Rank3" Grid.Column="0" Text="03" Style="{StaticResource MutedText}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CharName3" Grid.Column="1" Text="—" Style="{StaticResource SubHeaderText}" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CharJob3" Grid.Column="2" Text="" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <TextBlock x:Name="CharLevel3" Grid.Column="3" Text="" Style="{StaticResource MutedText}" FontSize="14" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="22,18">
                    <StackPanel>
                        <TextBlock Text="WALLET" Style="{StaticResource HudLight}"/>
                        <TextBlock x:Name="WalletOwner" Text="NOT LINKED" Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,14"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="NX" Style="{StaticResource SubHeaderText}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NxText" Grid.Column="1" Text="0" Style="{StaticResource AccentText}" FontSize="15" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="DP" Style="{StaticResource SubHeaderText}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DpText" Grid.Column="1" Text="0" Style="{StaticResource AccentText}" FontSize="15" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="VP" Style="{StaticResource SubHeaderText}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="VpText" Grid.Column="1" Text="0" Style="{StaticResource AccentText}" FontSize="15" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- RADAR -->
        <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="0,8,0,8" Padding="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="LINK RADAR" Style="{StaticResource HudLight}"/>
                    <TextBlock Text="Server handshake" Style="{StaticResource BodyText}" Margin="0,4,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Ellipse x:Name="RadarRing1" Stroke="{StaticResource BorderBrush}" StrokeThickness="1"/>
                    <Ellipse x:Name="RadarRing2" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" Margin="42"/>
                    <Ellipse x:Name="RadarRing3" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" Margin="84"/>

                    <Grid>
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="RadarRotation"/>
                        </Grid.RenderTransform>
                        <Path x:Name="RadarSweep"
                              Data="M0,0 L140,100 L0,200 Z"
                              Stretch="Uniform"
                              Opacity="0.35"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Width="180" Height="180"
                              IsHitTestVisible="False"/>
                    </Grid>

                    <Ellipse Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="{DynamicResource PrimaryAccentColor}" Opacity="0.9"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Grid>

                <StackPanel Grid.Row="2">
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ApiEndpointText" Text="API : 127.0.0.1 : 8483" Style="{StaticResource BodyText}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="LoginEndpointText" Text="LOGIN : 127.0.0.1 : 8484" Style="{StaticResource BodyText}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ChannelText" Text="CHANNELS : 10" Style="{StaticResource BodyText}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>