<UserControl x:Class="v232.Launcher.WPF.Views.PlayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <!-- LAUNCH MAIN -->
        <Grid Margin="0,30,36,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="// GAME LAUNCH" Style="{StaticResource HudLight}" Margin="0,0,0,14"/>
                <TextBlock x:Name="LaunchPanelTitle" Text="CLAXON TERMINAL" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="LaunchDescriptionText" Text="Launches MapleStory.exe with an authentication token and injects the authhook."
                           Style="{StaticResource BodyText}" Margin="0,10,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <Button x:Name="LaunchButton" Style="{StaticResource GlowButton}" HorizontalAlignment="Left"
                        Width="340" Padding="0,22" FontSize="18">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M8,5 L19,12 L8,19 Z" Fill="{StaticResource BackgroundDeepBrush}" Width="18" Height="18"
                              Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <TextBlock Text="LAUNCH GAME" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Border Style="{StaticResource GlassCard}" Padding="16,10" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="SignedInText" Text="SIGNED IN READY" Style="{StaticResource AccentText}" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" Padding="16,10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LaunchStatusDot" Width="8" Height="8" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="LaunchStatusText" Text="SCANNING CLIENT" Style="{StaticResource AccentText}" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="LaunchNote" Text="Running as Administrator is required for DLL injection."
                           Style="{StaticResource MutedText}" Margin="0,14,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <Button x:Name="LogoutButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                        Content="LOGOUT" Padding="24,10" FontSize="11"/>
            </StackPanel>
        </Grid>

        <!-- SYSTEM READOUT -->
        <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="0,8,0,8" Padding="24">
            <StackPanel>
                <TextBlock Text="SYSTEM READOUT" Style="{StaticResource HudLight}" Margin="0,0,0,6"/>
                <TextBlock Text="Pre-launch diagnostics" Style="{StaticResource BodyText}" Margin="0,0,0,22"/>

                <TextBlock Text="CLIENT DIRECTORY" Style="{StaticResource HudLight}" Margin="0,14,0,4"/>
                <TextBlock x:Name="ReadoutClientDir" Text="Scanning..." Style="{StaticResource BodyText}" TextWrapping="Wrap"/>

                <TextBlock Text="MapleStory.EXE" Style="{StaticResource HudLight}" Margin="0,14,0,4"/>
                <TextBlock x:Name="ReadoutExe" Text="..." Style="{StaticResource BodyText}"/>

                <TextBlock x:Name="ReadoutHookLabel" Text="AUTHHOOK (Localhost.dll)" Style="{StaticResource HudLight}" Margin="0,14,0,4"/>
                <TextBlock x:Name="ReadoutHook" Text="..." Style="{StaticResource BodyText}"/>

                <TextBlock Text="API ENDPOINT" Style="{StaticResource HudLight}" Margin="0,14,0,4"/>
                <TextBlock x:Name="ReadoutApiEndpoint" Text="127.0.0.1 : 8483" Style="{StaticResource BodyText}"/>

                <TextBlock Text="LOGIN PORT" Style="{StaticResource HudLight}" Margin="0,14,0,4"/>
                <TextBlock x:Name="ReadoutLoginPort" Text="8484" Style="{StaticResource BodyText}"/>

                <TextBlock Text="GAME VERSION" Style="{StaticResource HudLight}" Margin="0,14,0,4"/>
                <TextBlock Text="v265" Style="{StaticResource BodyText}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>