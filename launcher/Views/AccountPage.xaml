<UserControl x:Class="v232.Launcher.WPF.Views.AccountPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="440">
        <!-- LOGIN -->
        <Border x:Name="LoginFormPanel" Style="{StaticResource GlassCard}" Padding="34" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="// ACCESS CODE" Style="{StaticResource HudLight}" Margin="0,0,0,16"/>
                <TextBlock Text="Welcome back" Style="{StaticResource HeaderText}"/>
                <TextBlock Text="Authenticate to the grid" Style="{StaticResource BodyText}" Margin="0,6,0,30"/>

                <TextBlock Text="USERNAME" Style="{StaticResource HudLight}" Margin="0,0,0,4"/>
                <TextBox x:Name="LoginUsername" x:FieldModifier="public" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20"/>

                <TextBlock Text="PASSWORD" Style="{StaticResource HudLight}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="LoginPassword" x:FieldModifier="public" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,10"/>

                <CheckBox x:Name="LoginRemember" x:FieldModifier="public" Content="Remember username" Style="{StaticResource ModernCheckBox}" Margin="0,6,0,24"/>

                <Button x:Name="LoginSubmit" Style="{StaticResource GlowButton}" Content="SIGN IN" Padding="0,14" FontSize="15"/>

                <TextBlock HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="12">
                    <Run Text="New to the grid? " Foreground="{StaticResource TextMutedBrush}"/>
                    <Hyperlink x:Name="LoginRegisterLink" Foreground="{DynamicResource PrimaryAccentBrush}" TextDecorations="None" Click="ShowRegister_Click">Create account</Hyperlink>
                </TextBlock>

                <TextBlock x:Name="LoginBusy" Text="" Style="{StaticResource HudLight}" HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- REGISTER -->
        <Border x:Name="RegisterFormPanel" Style="{StaticResource GlassCard}" Padding="34" Visibility="Collapsed" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="// NEW UNIT" Style="{StaticResource HudLight}" Margin="0,0,0,16"/>
                <TextBlock Text="Create account" Style="{StaticResource HeaderText}"/>
                <TextBlock Text="Join the grid" Style="{StaticResource BodyText}" Margin="0,6,0,26"/>

                <TextBlock Text="USERNAME" Style="{StaticResource HudLight}" Margin="0,0,0,4"/>
                <TextBox x:Name="RegisterUsername" x:FieldModifier="public" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                <TextBlock Text="EMAIL" Style="{StaticResource HudLight}" Margin="0,0,0,4"/>
                <TextBox x:Name="RegisterEmail" x:FieldModifier="public" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                <TextBlock Text="PASSWORD" Style="{StaticResource HudLight}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="RegisterPassword" x:FieldModifier="public" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,16"/>

                <TextBlock Text="CONFIRM PASSWORD" Style="{StaticResource HudLight}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="RegisterConfirmPassword" x:FieldModifier="public" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,26"/>

                <Button x:Name="RegisterSubmit" Style="{StaticResource GlowButton}" Content="CREATE ACCOUNT" Padding="0,14" FontSize="15"/>

                <TextBlock HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="12">
                    <Run Text="Already registered? " Foreground="{StaticResource TextMutedBrush}"/>
                    <Hyperlink x:Name="RegisterLoginLink" Foreground="{DynamicResource PrimaryAccentBrush}" TextDecorations="None" Click="ShowLogin_Click">Sign in</Hyperlink>
                </TextBlock>

                <TextBlock x:Name="RegisterBusy" Text="" Style="{StaticResource HudLight}" HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- LOGGED IN -->
        <Border x:Name="AccountPanel" Style="{StaticResource GlassCard}" Padding="34" Visibility="Collapsed" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="// IDENTITY" Style="{StaticResource HudLight}" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <Border Width="64" Height="64" CornerRadius="32"
                            BorderBrush="{DynamicResource PrimaryAccentBrush}" BorderThickness="2">
                        <Border.Background>
                            <RadialGradientBrush GradientOrigin="0.4,0.3">
                                <GradientStop Color="{DynamicResource BackgroundHoverColor}" Offset="0"/>
                                <GradientStop Color="{DynamicResource BackgroundElevatedColor}" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                        <TextBlock x:Name="AvatarInitial" Text="?" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AccountUsername" Text="Username" Style="{StaticResource HeaderText}" FontSize="20"/>
                        <TextBlock x:Name="AccountStatus" Text="Authenticated" Style="{StaticResource BodyText}" Margin="0,5,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="LogoutButton" Style="{StaticResource GhostButton}" Content="LOGOUT" Padding="0,12" FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>