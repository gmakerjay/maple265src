<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- CYAN CORE PALETTE -->
    <Color x:Key="PrimaryAccentColor">#00E5FF</Color>
    <Color x:Key="SecondaryAccentColor">#8B7CFF</Color>
    <Color x:Key="AccentGlowColor">#4000E5FF</Color>

    <Color x:Key="BackgroundDeepColor">#05070F</Color>
    <Color x:Key="BackgroundCardColor">#0B0F1E</Color>
    <Color x:Key="BackgroundElevatedColor">#131A2E</Color>
    <Color x:Key="BackgroundHoverColor">#1A2440</Color>
    <Color x:Key="GlassFillColor">#120E1A2E</Color>

    <Color x:Key="TextPrimaryColor">#EAF6FF</Color>
    <Color x:Key="TextSecondaryColor">#9FB3C8</Color>
    <Color x:Key="TextMutedColor">#5E7186</Color>

    <Color x:Key="SuccessColor">#2DE0A0</Color>
    <Color x:Key="ErrorColor">#FF4D6D</Color>
    <Color x:Key="WarningColor">#FFC94D</Color>

    <Color x:Key="BorderColor">#1E2A45</Color>
    <Color x:Key="BorderGlowColor">#4000E5FF</Color>

</ResourceDictionary>