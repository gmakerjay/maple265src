<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- VIOLET PULSE PALETTE -->
    <Color x:Key="PrimaryAccentColor">#A78BFA</Color>
    <Color x:Key="SecondaryAccentColor">#F472B6</Color>
    <Color x:Key="AccentGlowColor">#40A78BFA</Color>

    <Color x:Key="BackgroundDeepColor">#08050F</Color>
    <Color x:Key="BackgroundCardColor">#100A1F</Color>
    <Color x:Key="BackgroundElevatedColor">#1A1130</Color>
    <Color x:Key="BackgroundHoverColor">#241A42</Color>
    <Color x:Key="GlassFillColor">#121E1030</Color>

    <Color x:Key="TextPrimaryColor">#F6F1FF</Color>
    <Color x:Key="TextSecondaryColor">#BCAED6</Color>
    <Color x:Key="TextMutedColor">#75668F</Color>

    <Color x:Key="SuccessColor">#6EE7B7</Color>
    <Color x:Key="ErrorColor">#FF6B8A</Color>
    <Color x:Key="WarningColor">#FFD166</Color>

    <Color x:Key="BorderColor">#2C2148</Color>
    <Color x:Key="BorderGlowColor">#40A78BFA</Color>

</ResourceDictionary>