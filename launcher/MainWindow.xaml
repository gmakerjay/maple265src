<Window x:Class="v232.Launcher.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:views="clr-namespace:v232.Launcher.WPF.Views"
        Title="KonoMS Launcher"
        Height="840"
        Width="1280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="Assets/maplestorydb-logo.png">

    <!-- ROOT SHELL -->
    <Border x:Name="RootShell" CornerRadius="14"
            Background="{DynamicResource BackgroundGradientBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <!-- ═══════════ AMBIENT LAYERS ═══════════ -->
            <Image x:Name="GifBackground" Stretch="UniformToFill" Opacity="0.45"/>
            <Border Background="{DynamicResource BackgroundDeepBrush}" Opacity="0.55"/>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#CC05070F" Offset="0"/>
                        <GradientStop Color="#5505070F" Offset="0.35"/>
                        <GradientStop Color="#3305070F" Offset="0.65"/>
                        <GradientStop Color="#0005070F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Rectangle Fill="{StaticResource HexPatternBrush}"/>

            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top"
                       Width="330" Height="740" Opacity="0.10">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource PrimaryAccentColor}" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="-18"/>
                </Rectangle.RenderTransform>
            </Rectangle>

            <Canvas x:Name="ParticleLayer" ClipToBounds="True" IsHitTestVisible="False"/>
            <Rectangle Fill="{StaticResource ScanlineBrush}" Opacity="0.05" IsHitTestVisible="False"/>
            <Rectangle Fill="{StaticResource VignetteBrush}" IsHitTestVisible="False"/>

            <!-- ═══════════ HEADER ═══════════ -->
            <Grid Height="64" VerticalAlignment="Top">
                <Border Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown"/>

                <!-- BRAND -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,0,0">
                    <Image Source="Assets/maplestorydb-logo.png" Width="30" Height="28" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="BrandNameText" Text="KonoMS" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="{DynamicResource PrimaryAccentColor}" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <Border Background="{StaticResource BackgroundElevatedBrush}" CornerRadius="4"
                            Padding="8,3" Margin="14,0,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock Text="v265" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    </Border>
                </StackPanel>

                <!-- NAV TABS -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="NavHome" Tag="home" Style="{StaticResource IconButton}" Width="92" Height="46" Click="NavButton_Click">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="NavLabelHome" Text="HOME" FontFamily="{StaticResource DisplayFont}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <Rectangle x:Name="NavIndicatorHome" Height="2" RadiusX="1" RadiusY="1" Fill="{StaticResource PrimaryAccentBrush}"
                                       HorizontalAlignment="Stretch" Margin="14,5,14,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavPlay" Tag="play" Style="{StaticResource IconButton}" Width="92" Height="46" Click="NavButton_Click">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="NavLabelPlay" Text="PLAY" FontFamily="{StaticResource DisplayFont}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <Rectangle x:Name="NavIndicatorPlay" Height="2" RadiusX="1" RadiusY="1" Fill="{StaticResource PrimaryAccentBrush}"
                                       HorizontalAlignment="Stretch" Margin="14,5,14,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavAccount" Tag="account" Style="{StaticResource IconButton}" Width="92" Height="46" Click="NavButton_Click">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="NavLabelAccount" Text="ACCOUNT" FontFamily="{StaticResource DisplayFont}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <Rectangle x:Name="NavIndicatorAccount" Height="2" RadiusX="1" RadiusY="1" Fill="{StaticResource PrimaryAccentBrush}"
                                       HorizontalAlignment="Stretch" Margin="14,5,14,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- STATUS + WINDOW CONTROLS -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Border Background="{StaticResource GlassFillBrush}" CornerRadius="6" Padding="12,7"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusText" Text="CONNECTING" FontSize="11" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource IconButton}" Click="MinimizeButton_Click">
                        <Path Data="M0,5 H10" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="10" Height="10"/>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="CloseButton_Click">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="10" Height="10"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══════════ PAGE HOST ═══════════ -->
            <Grid Margin="28,72,28,58">
                <views:HomePage x:Name="HomePageView"/>
                <views:PlayPage x:Name="PlayPageView" Visibility="Collapsed"/>
                <views:AccountPage x:Name="AccountPageView" Visibility="Collapsed"/>
            </Grid>

            <!-- ═══════════ FOOTER + GEAR (bottom-left) ═══════════ -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="22,0,0,14">
                <Button x:Name="GearButton" Style="{StaticResource IconButton}" Width="34" Height="34" VerticalAlignment="Center"
                        Click="GearButton_Click" ToolTip="Settings">
                    <Path x:Name="GearIcon"
                          Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                          Fill="{StaticResource PrimaryAccentBrush}" Width="17" Height="17" Stretch="Uniform"/>
                </Button>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False">
                    <TextBlock x:Name="FooterVersionText" Text="v1.0.0.22" Style="{StaticResource MutedText}" FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock Text="  |  " Style="{StaticResource MutedText}" FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FooterInfoText" Text="Modified from the V232 Swordie-Launcher" Style="{StaticResource MutedText}" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <Border x:Name="CreditsButton" Width="26" Height="26" CornerRadius="13"
                    Background="{StaticResource BackgroundElevatedBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,26,16" Cursor="Hand"
                    MouseLeftButtonUp="CreditsButton_Click">
                <TextBlock Text="?" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- ═══════════ CREDITS POPUP ═══════════ -->
            <Border x:Name="CreditsPopup" Visibility="Collapsed" Background="#E0000000" CornerRadius="14">
                <Border Style="{StaticResource GlassCard}" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MinWidth="320" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="CREDITS" Style="{StaticResource HeaderText}" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="Backend" Style="{StaticResource HudLight}" Margin="0,0,0,4"/>
                        <TextBlock Text="Level &amp; NutNNut" Style="{StaticResource BodyText}" Margin="0,0,0,16"/>
                        <TextBlock Text="Frontend Launcher" Style="{StaticResource HudLight}" Margin="0,0,0,4"/>
                        <TextBlock Text="Modified from the V232 Swordie-Launcher" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <TextBlock Text="Modifications" Style="{StaticResource HudLight}" Margin="0,0,0,4"/>
                        <TextBlock Text="Modifications done by Iskono" Style="{StaticResource AccentText}" TextWrapping="Wrap" Margin="0,0,0,20"/>
                        <Button Style="{StaticResource GhostButton}" Content="Close" HorizontalAlignment="Center" Padding="28,10" Click="CloseCredits_Click"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ═══════════ GEAR SETTINGS POPUP ═══════════ -->
            <!-- Declared last on purpose: in WPF later siblings paint on top, so this
                 keeps the panel above the page content instead of under it. -->
            <Border x:Name="GearPopup" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="24,0,0,64" Width="320" Background="Transparent">
                <Border Style="{StaticResource GlassCard}" Padding="22,18" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="CONFIGURATION" Style="{StaticResource HudLight}" VerticalAlignment="Center"/>
                            <Button x:Name="GearPopupClose" Style="{StaticResource IconButton}" Width="22" Height="22"
                                    HorizontalAlignment="Right" Click="GearPopupClose_Click">
                                <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.4" Width="8" Height="8"/>
                            </Button>
                        </Grid>

                        <!-- AUDIO -->
                        <TextBlock Text="AUDIO" Style="{StaticResource SubHeaderText}" FontSize="12" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="GearSoundButton" Style="{StaticResource GhostButton}" Width="96" Padding="0,10" Click="GearSoundButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="GearSoundIcon" Data="M4,8 L9,8 L14,4 L14,18 L9,14 L4,14 Z" Fill="{DynamicResource PrimaryAccentBrush}"
                                          Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="GearSoundText" Text="SOUND ON" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </Button>
                            <Slider x:Name="GearVolumeSlider" Style="{StaticResource ModernSlider}" Width="118"
                                    Minimum="0" Maximum="1" Value="0.5" VerticalAlignment="Center" Margin="14,0,0,0"
                                    ValueChanged="GearVolumeSlider_ValueChanged"/>
                            <TextBlock x:Name="GearVolumeLabel" Text="50%" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"/>
                        </StackPanel>

                        <!-- PALETTE -->
                        <TextBlock Text="PALETTE" Style="{StaticResource SubHeaderText}" FontSize="12" Margin="0,18,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="GearCyanChip" Style="{StaticResource ChipButton}" Content="CYAN CORE" Margin="0,0,10,0" Padding="20,10" Click="GearCyanChip_Click"/>
                            <Button x:Name="GearVioletChip" Style="{StaticResource ChipButton}" Content="VIOLET PULSE" Padding="20,10" Click="GearVioletChip_Click"/>
                        </StackPanel>

                        <!-- BACKGROUND -->
                        <TextBlock Text="BACKGROUND" Style="{StaticResource SubHeaderText}" FontSize="12" Margin="0,18,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="GearBgMotionChip" Style="{StaticResource ChipButton}" Content="MOTION" Margin="0,0,8,0" Padding="16,10" Click="GearBgMotion_Click"/>
                            <Button x:Name="GearBgCineChip" Style="{StaticResource ChipButton}" Content="CINEMATIC" Margin="0,0,8,0" Padding="16,10" Click="GearBgCine_Click"/>
                            <Button x:Name="GearBgOffChip" Style="{StaticResource ChipButton}" Content="OFF" Padding="16,10" Click="GearBgOff_Click"/>
                        </StackPanel>

                        <!-- SERVER NETWORK / LAN -->
                        <TextBlock Text="SERVER NETWORK (LAN / IP)" Style="{StaticResource SubHeaderText}" FontSize="12" Margin="0,18,0,6"/>
                        <TextBlock Text="Set host IP for LAN / VPN (e.g. 192.168.1.x / 127.0.0.1)" Style="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GearServerIpBox" Style="{StaticResource ModernTextBox}" Height="34" Margin="0" VerticalContentAlignment="Center"/>
                            <Button x:Name="GearApplyIpButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                    Content="APPLY" Padding="12,6" Margin="8,0,0,0" FontSize="11" Click="GearApplyIp_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ═══════════ LOADING OVERLAY ═══════════ -->
            <!-- BgmPlayer must keep a non-zero layout size or MediaElement refuses to play.
                 Hidden + 1x1 + no hit testing keeps it invisible and out of the way. -->
            <MediaElement x:Name="BgmPlayer" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                          Volume="0.5" Visibility="Hidden" Width="1" Height="1"
                          HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>

            <Border x:Name="LoadingOverlay" Background="{DynamicResource BackgroundDeepBrush}" CornerRadius="14">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="Assets/maplestorydb-logo.png" Width="56" Height="52" Stretch="Uniform" HorizontalAlignment="Center" Opacity="0.9"/>
                    <Border Width="140" Height="3" CornerRadius="1.5" Background="{StaticResource BackgroundElevatedBrush}" Margin="0,20,0,0">
                        <Border x:Name="ProgressFill" Width="40" HorizontalAlignment="Left" CornerRadius="1.5"
                                Background="{StaticResource PrimaryAccentBrush}"/>
                    </Border>
                    <TextBlock x:Name="LoadingBrandText" Text="KonoMS" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold"
                               Margin="0,14,0,4" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="SYNCING GRID..." Style="{StaticResource HudLight}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>